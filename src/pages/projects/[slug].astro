---
import Base from '../../layouts/Base.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import Video from '../../components/Video.astro';
import { projects, publicationsFor, tagLabel, type Project } from '../../lib/content';
import { resolveImage, resolveVideo } from '../../lib/media';
import '../../styles/theme.css';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project: p } = Astro.props as { project: Project };
const i = projects.findIndex((x) => x.slug === p.slug);
const next = projects[(i + 1) % projects.length];
// TODO labels show on the dev server only; the public build skips empty sections.
const sections = [
  { id: 'problem', h: 'Problem', body: p.problem },
  { id: 'what-i-did', h: 'What I did', body: p.what_i_did },
  { id: 'result', h: 'Result', body: p.result },
].filter((s) => s.body || import.meta.env.DEV);
const papers = publicationsFor(p);
const paperLink = (x: (typeof papers)[number]) => x.url ?? (x.doi ? `https://doi.org/${x.doi}` : null);
const toc = [
  ...sections, { id: 'role', h: 'Role' }, { id: 'credits', h: 'Credits' },
  ...(papers.length ? [{ id: 'publication', h: papers.length > 1 ? 'Publications' : 'Publication' }] : []),
  { id: 'links', h: 'Links' },
];
const images = (p.media.images ?? []).map((m) => resolveImage(m, p.slug)!);
const [lead, ...rest] = images;
const video = resolveVideo(p.media.video, p.slug);
---
<Base title={p.title} description={p.problem}>
  <main id="main" class="wrap project">
    <aside class="side" aria-label="Project summary">
      <div class="side-inner">
        <a class="back" href="/#work">Back to all projects</a>
        <h1 transition:name={`title-${p.slug}`}>{p.title} {p.status === 'draft' && <span class="draft-label">In progress</span>}</h1>
        <dl class="facts">
          <div><dt>Years</dt><dd>{p.years}</dd></div>
          {p.meta.place && <div><dt>Place</dt><dd>{p.meta.place}</dd></div>}
          <div><dt>Role</dt><dd>{p.meta.role}</dd></div>
          <div><dt>Areas</dt><dd>{p.tags.map((t) => tagLabel[t] ?? t).join(', ')}</dd></div>
        </dl>
        <nav class="toc" aria-label="On this page">
          <ul>{toc.map((s) => <li><a href={`#${s.id}`}>{s.h}</a></li>)}</ul>
        </nav>
      </div>
    </aside>

    <div class="content">
      <div class="lead" transition:name={`media-${p.slug}`}>
        {lead ? <MediaFrame image={lead} slug={p.slug} size="large" />
          : !video && <MediaFrame image={null} slug={p.slug} size="large" />}
      </div>

      {sections.map((s) => (
        <section id={s.id}>
          <h2>{s.h}</h2>
          {s.body ? <p>{s.body}</p> : <p><span class="todo">TODO: {s.h.toLowerCase()} not yet written in projects.yaml</span></p>}
        </section>
      ))}
      <section id="role">
        <h2>Role</h2>
        <p>{p.role}</p>
      </section>
      <section id="credits">
        <h2>Credits</h2>
        <p>{p.credits}</p>
      </section>
      {papers.length > 0 && (
        <section id="publication">
          <h2>{papers.length > 1 ? 'Publications' : 'Publication'}</h2>
          <ul class="papers">
            {papers.map((x) => {
              const href = paperLink(x);
              return <li><span class="paper-title">{href ? <a href={href} rel="noopener">{x.title}</a> : x.title}</span> <span class="paper-cite">{x.authors} ({x.year}). {x.venue}.</span></li>;
            })}
          </ul>
        </section>
      )}
      <section id="links">
        <h2>Links</h2>
        {p.links.length ? (
          <ul>{p.links.map((l) => <li><a href={l.url} rel="noopener">{l.label}</a></li>)}</ul>
        ) : <p class="none">No public links yet.</p>}
      </section>

      {(rest.length > 0 || video) && (
        <div class="gallery">
          {rest.map((img) => <MediaFrame image={img} slug={p.slug} size="large" />)}
          {video && (
            video.url ? (
              <figure class="video">
                <Video src={video.url} poster={video.poster} width={video.poster?.width ?? 1280} height={video.poster?.height ?? 720}
                  label={video.caption ?? `Video for ${p.title}`} />
                {(video.caption || video.credit) && <figcaption>{video.caption} {video.credit}</figcaption>}
              </figure>
            ) : import.meta.env.DEV && <p><span class="todo">TODO: add the file {video.path} (listed in projects.yaml, not in the repo yet)</span></p>
          )}
        </div>
      )}

      <nav class="next" aria-label="Next project">
        <span>Next project</span>
        <a href={`/projects/${next.slug}/`}>{next.title}</a>
      </nav>
    </div>
  </main>
</Base>
<style>
  .project { padding-block: 1.25rem 5rem; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; }
  /* Sidebar: stacked above the content on phones and tablets, sticky beside it from 1024 px. */
  @media (min-width: 64rem) {
    .project { grid-template-columns: 19rem minmax(0, 1fr); column-gap: clamp(2.5rem, 5vw, 4.5rem); padding-top: 2.5rem; }
    .side-inner { position: sticky; top: 2rem; max-height: calc(100svh - 4rem); overflow-y: auto; padding-right: .25rem; }
  }
  .side-inner { display: grid; gap: 1.5rem; align-content: start; }
  .back { justify-self: start; }
  h1 { font-variation-settings: 'wdth' 110; font-weight: 750; font-size: clamp(2rem, 5.5vw, 3.6rem); line-height: 1.04; letter-spacing: -.012em; margin: 0; max-width: 22ch; }
  @media (min-width: 64rem) { h1 { font-size: clamp(2rem, 2.6vw, 2.6rem); } }
  .facts { margin: 0; display: grid; gap: .6rem; }
  .facts div { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); gap: .75rem; align-items: baseline; }
  .facts dt { color: var(--muted); font-size: .875rem; font-weight: 600; font-variation-settings: 'wdth' 82; }
  .facts dd { margin: 0; font-weight: 550; }
  .toc { border-top: 1px solid var(--rule); padding-top: 1rem; }
  .toc ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; }
  @media (min-width: 64rem) { .toc ul { display: grid; gap: .1rem; } }
  .toc a { display: inline-block; padding: .3rem 0; text-decoration: none; color: var(--blue); }
  .toc a:hover { text-decoration: underline; text-decoration-thickness: 3px; }

  .content { display: grid; gap: 2.25rem; align-content: start; min-width: 0; }
  .lead:empty { display: none; }
  section { scroll-margin-top: 1.5rem; }
  section p { margin: 0; max-width: 66ch; }
  h2 { font-size: 1rem; font-weight: 700; margin: 0 0 .4rem; font-variation-settings: 'wdth' 100; }
  section ul { margin: 0; padding-left: 1.1rem; }
  .none { color: var(--muted); }
  .papers { list-style: none; padding: 0; display: grid; gap: .75rem; max-width: 66ch; }
  .paper-title { font-weight: 650; }
  .paper-cite { display: block; color: var(--muted); }
  .gallery { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; }
  .video { margin: 0; }
  .video :global(video) { display: block; width: 100%; height: auto; border-radius: 10px; background: var(--surface); }
  .video figcaption { margin-top: .75rem; color: var(--muted); font-size: .9375rem; }
  .next { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); display: grid; gap: .25rem; }
  .next span { color: var(--muted); font-size: .9375rem; }
  .next a { font-size: 1.375rem; font-weight: 650; }
</style>
