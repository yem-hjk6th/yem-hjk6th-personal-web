---
import Base from '../../layouts/Base.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import { projects, tagLabel, type Project } from '../../lib/content';
import { resolveImage, resolveVideo } from '../../lib/media';
import '../../styles/theme.css';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project: p } = Astro.props as { project: Project };
const i = projects.findIndex((x) => x.slug === p.slug);
const next = projects[(i + 1) % projects.length];
const sections: { h: string; body: string | null }[] = [
  { h: 'Problem', body: p.problem },
  { h: 'What I did', body: p.what_i_did },
  { h: 'Result', body: p.result },
];
const images = (p.media.images ?? []).map((m) => resolveImage(m, p.slug)!);
const video = resolveVideo(p.media.video, p.slug);
---
<Base title={p.title} description={p.problem}>
  <header class="wrap top">
    <a href="/#work">Back to all projects</a>
  </header>
  <main id="main" class="wrap project">
    <div class="head">
      <p class="meta"><span>{p.years}</span>{p.tags.map((t) => <span class="tag">{tagLabel[t] ?? t}</span>)}</p>
      <h1>{p.title} {p.status === 'draft' && <span class="draft-label">In progress</span>}</h1>
    </div>

    <div class="gallery">
      {images.length === 0 && !video && <MediaFrame image={null} slug={p.slug} size="large" />}
      {images.map((img) => <MediaFrame image={img} slug={p.slug} size="large" />)}
      {video && (
        video.url ? (
          <figure class="video">
            <video controls preload="none" playsinline poster={video.posterUrl ?? undefined} src={video.url}></video>
            {(video.caption || video.credit) && <figcaption>{video.caption} {video.credit}</figcaption>}
          </figure>
        ) : import.meta.env.DEV && <p><span class="todo">TODO: add the file {video.path} (listed in projects.yaml, not in the repo yet)</span></p>
      )}
    </div>

    <div class="body">
      <div class="sections">
        {/* TODO labels show on the dev server only; the public build skips empty sections. */}
        {sections.filter((s) => s.body || import.meta.env.DEV).map((s) => (
          <section>
            <h2>{s.h}</h2>
            {s.body ? <p>{s.body}</p> : <p><span class="todo">TODO: {s.h.toLowerCase()} not yet written in projects.yaml</span></p>}
          </section>
        ))}
      </div>
      <aside>
        <h2>Role</h2>
        <p>{p.role}</p>
        <h2>Credits</h2>
        <p>{p.credits}</p>
        <h2>Links</h2>
        {p.links.length ? (
          <ul>{p.links.map((l) => <li><a href={l.url} rel="noopener">{l.label}</a></li>)}</ul>
        ) : <p class="none">No public links yet.</p>}
      </aside>
    </div>
    <nav class="next" aria-label="Next project">
      <span>Next project</span>
      <a href={`/projects/${next.slug}/`}>{next.title}</a>
    </nav>
  </main>
</Base>
<style>
  .top { padding-block: 1.25rem; }
  .project { padding-bottom: 5rem; }
  .meta { display: flex; flex-wrap: wrap; gap: .5rem 1rem; color: var(--muted); margin: 1.5rem 0 .5rem; }
  .tag { border: 1px solid var(--rule); border-radius: 999px; padding: 0 .6rem; font-size: .875rem; }
  h1 { font-variation-settings: 'wdth' 110; font-weight: 750; font-size: clamp(2rem, 5.5vw, 3.6rem); line-height: 1.04; letter-spacing: -.012em; margin: 0 0 2rem; max-width: 22ch; }
  .gallery { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; margin: 0 0 3rem; }
  .video { margin: 0; }
  .video video { width: 100%; border-radius: 10px; background: var(--surface); }
  .video figcaption { margin-top: .75rem; color: var(--muted); font-size: .9375rem; }
  .body { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; }
  @media (min-width: 60rem) { .body { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); column-gap: 4rem; } .body aside { align-self: start; } }
  .sections { display: grid; gap: 2rem; align-content: start; }
  section p, aside p { margin: 0; max-width: 66ch; }
  h2 { font-size: 1rem; font-weight: 700; margin: 0 0 .4rem; font-variation-settings: 'wdth' 100; }
  aside h2:not(:first-child) { margin-top: 1.5rem; }
  aside { border-top: 1px solid var(--rule); padding-top: 1.5rem; }
  @media (min-width: 60rem) { aside { border-top: 0; border-left: 1px solid var(--rule); padding: 0 0 0 2rem; } }
  aside ul { margin: 0; padding-left: 1.1rem; }
  .none { color: var(--muted); }
  .next { margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); display: grid; gap: .25rem; }
  .next span { color: var(--muted); font-size: .9375rem; }
  .next a { font-size: 1.375rem; font-weight: 650; }
</style>
