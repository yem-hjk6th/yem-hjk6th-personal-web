---
// The homepage (chosen variant 3): variant 1's "Print bed" layout with
// React Bits interactions, on the dark theme from styles/theme.css.
import MediaFrame from './MediaFrame.astro';
import {
  profile, projects, publications, presentations, exhibitions, experience,
  audiences, audiencesFor, tagLabel, firstSentence, contactLinks,
} from '../lib/content';
import { resolveImage } from '../lib/media';
import ProximityName from './reactbits/ProximityName';
import RevealBio from './reactbits/RevealBio';
import Spotlight from './reactbits/Spotlight';
import MagnetLink from './reactbits/MagnetLink';

const pubsByYear = [...publications].sort((a, b) => b.year - a.year);
const others = [
  ...presentations.map((p) => ({ ...p, kind: 'Presentation' })),
  ...exhibitions.map((p) => ({ ...p, kind: 'Exhibition' })),
];
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const pubLink = (p: (typeof publications)[number]) => p.url ?? (p.doi ? `https://doi.org/${p.doi}` : null);
---
<div class="home">
  <header class="bar">
    <a class="bar-name" href="#top">{profile.name}</a>
    <nav aria-label="Sections">
      <a href="#work">Work</a>
      <a href="#publications">Publications</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero" id="top" aria-labelledby="name">
      <div class="stage">
        <canvas id="hero-canvas" width="320" height="180" role="img"
          aria-label="Pixel animation in three scenes: a robot prints while four sensors (robot telemetry, a stereo camera, a bead camera and a nozzle borescope) send data; the view steps out to a lab monitor that builds a live 3D reconstruction of the print; then a large robot arm prints a ship hull."></canvas>
      </div>
      <div class="hero-text">
        <h1 id="name" class="name">
          <button type="button" class="name-btn" aria-haspopup="dialog" aria-controls="float-win">
            <ProximityName client:load label={profile.name} />
          </button>
        </h1>
        <p class="affil">{profile.affiliation}, {profile.location}</p>
      </div>
      <div class="entries">
        {audiences.map((a) => (
          <div class="entry">
            <h2 class="entry-label">{a.label}</h2>
            <p class="entry-headline">{a.headline}</p>
            <button type="button" class="pill" data-audience={a.id} data-label={a.label} data-scroll="#work" aria-pressed="false">
              Show {a.label} projects
            </button>
          </div>
        ))}
      </div>
    </section>

    <section class="work" id="work" aria-labelledby="work-h">
      <div class="work-head">
        <h2 id="work-h" class="sec-h">Work</h2>
        <div class="filters" role="group" aria-label="Filter projects by audience">
          <button type="button" class="pill" data-audience="all" data-label="all" aria-pressed="true">All</button>
          {audiences.map((a) => <button type="button" class="pill" data-audience={a.id} data-label={a.label} aria-pressed="false">{a.label}</button>)}
        </div>
        <p class="filter-status" data-filter-status aria-live="polite"></p>
      </div>
      <ol class="layers">
        {projects.map((p) => (
          <li class="layer" data-audiences={audiencesFor(p).join(' ')}>
            <Spotlight client:visible>
              <a class="layer-link" href={`/projects/${p.slug}/`}>
                <MediaFrame image={resolveImage(p.media.thumbnail, p.slug)} slug={p.slug} size="thumb" class="layer-thumb" />
                <span class="layer-main">
                  <span class="layer-title">{p.title}{p.status === 'draft' && <span class="draft-label">In progress</span>}</span>
                  <span class="layer-problem">{firstSentence(p.problem)}</span>
                </span>
                <span class="layer-meta">
                  <span class="layer-years">{p.years}</span>
                  <span class="layer-tags">{p.tags.map((t) => tagLabel[t] ?? t).join(', ')}</span>
                </span>
              </a>
            </Spotlight>
          </li>
        ))}
      </ol>
    </section>

    <section class="about" aria-labelledby="about-h">
      <h2 id="about-h" class="sec-h">About</h2>
      <div class="about-grid">
        <div class="bio"><RevealBio client:visible text={profile.bio} /></div>
        <div class="cv">
          <h3>Experience</h3>
          <ul class="timeline">
            {experience.map((e) => (
              <li>
                <span class="t-years">{e.years}</span>
                <span class="t-body"><strong>{e.role}</strong>, {e.org}{e.location && `, ${e.location}`}. {e.summary}</span>
              </li>
            ))}
          </ul>
          <h3>Education</h3>
          <ul class="timeline">
            {profile.education.map((e) => (
              <li>
                <span class="t-years">{e.years}</span>
                <span class="t-body"><strong>{e.degree}</strong>, {e.school}.{e.detail && ` ${e.detail}`}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="pubs" id="publications" aria-labelledby="pubs-h">
      <h2 id="pubs-h" class="sec-h">Publications</h2>
      <ul class="pub-list">
        {pubsByYear.map((p) => {
          const href = pubLink(p);
          return (
            <li>
              <span class="pub-year">{p.year}</span>
              <span class="pub-body">
                <span class="pub-title">{href ? <a href={href} rel="noopener">{p.title}</a> : p.title}</span>
                <span class="pub-cite">{p.authors} {p.venue}. <span class="pub-type">{cap(p.type)}</span></span>
              </span>
            </li>
          );
        })}
      </ul>
      <h3 class="sub-h">Presentations and exhibitions</h3>
      <ul class="pub-list">
        {others.map((p) => (
          <li>
            <span class="pub-year">{p.year}</span>
            <span class="pub-body"><span class="pub-title">{p.title}</span><span class="pub-cite">{p.kind}, {p.venue}</span></span>
          </li>
        ))}
      </ul>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-h">
      <h2 id="contact-h" class="sec-h">Contact</h2>
      <ul class="contact-list">
        {contactLinks.map((c) => (
          <li>
            <span class="c-label">{c.label}</span>
            <MagnetLink client:visible href={c.href} text={c.text} />
          </li>
        ))}
      </ul>
    </section>
  </main>

  <dialog id="float-win" class="win" aria-labelledby="win-title">
    <div class="win-bar" data-drag>
      <h2 id="win-title" class="win-title">Window preview</h2>
      <button type="button" class="win-close" data-close autofocus>
        <span aria-hidden="true">×</span><span class="sr-only">Close window</span>
      </button>
    </div>
    <div class="win-body">
      <canvas class="win-canvas" role="img" aria-label="Placeholder animation: a Hilbert-curve toolpath printed bead by bead"></canvas>
      <p class="win-note">Placeholder animation. What this window shows is still to be decided.</p>
    </div>
  </dialog>
</div>

<script>
  import { initMotion } from '../scripts/motion';
  import { initFilter } from '../scripts/filter';
  import { mountHero } from '../scripts/hero';
  import { initFloatingWindow } from '../scripts/floating-window';
  initMotion();
  initFilter();
  mountHero(document.querySelector<HTMLCanvasElement>('#hero-canvas'));
  initFloatingWindow(document.querySelector('.name-btn'), document.querySelector<HTMLDialogElement>('#float-win'));
</script>

<style>
  .home { --pad: clamp(1rem, 4vw, 3.5rem); }
  .home h1, .home h2, .home h3 { margin: 0; }

  /* Bead rule: two stacked rounded lines, like printed layers. */
  .layers, .layer {
    background-image: linear-gradient(var(--rule), var(--rule)), linear-gradient(var(--rule), var(--rule));
    background-size: 100% 3px, 100% 3px; background-repeat: no-repeat;
    background-position: 0 100%, 0 calc(100% - 5px);
  }

  .bar { position: absolute; inset: 0 0 auto 0; z-index: 5; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem var(--pad); }
  .bar-name { font-weight: 700; color: var(--ink); text-decoration: none; font-variation-settings: 'wdth' 112; }
  .bar nav { display: flex; gap: clamp(.75rem, 3vw, 2rem); }
  .bar nav a { color: var(--ink); text-decoration: none; font-weight: 500; padding: .5rem 0; }
  .bar a:hover { color: var(--gold); text-decoration: underline; text-decoration-thickness: 3px; }

  /* Hero */
  .hero { position: relative; min-height: 100svh; display: grid; grid-template-rows: 1fr auto auto; padding: 5rem var(--pad) 0;
    background: repeating-linear-gradient(to bottom, transparent 0 7px, color-mix(in srgb, var(--bg), #FFFFFF 5%) 7px 8px); }
  /* Pixel story: 320 x 180 canvas scaled up with hard pixel edges, letterboxed at 16:9. */
  /* Pinned to the top right so the canvas clears the name below it. */
  .stage { position: absolute; top: 4rem; right: var(--pad); width: 52%; height: max(16rem, calc(100svh - 23rem)); pointer-events: none; }
  .stage canvas { width: 100%; height: 100%; object-fit: contain; object-position: right top; image-rendering: pixelated; image-rendering: crisp-edges; }
  .hero-text { position: relative; align-self: end; padding-bottom: 2rem; }
  .name { font-size: clamp(3.6rem, 13vw, 11.5rem); line-height: .86; font-weight: 820; letter-spacing: -.02em;
    font-variation-settings: 'wdth' 125; margin-left: -.04em; }
  .name :global(.variable-proximity) { font-family: inherit; }
  /* The name is a button that opens the floating window; it looks like the heading. */
  .name-btn { all: unset; cursor: pointer; display: inline-block; color: var(--ink); border-radius: 6px; }
  .name-btn:focus-visible { outline: 3px solid var(--gold); outline-offset: 6px; }

  /* Floating window: blue/grey chrome, black body. */
  .win { padding: 0; border: 1px solid var(--blue); border-radius: 8px; background: var(--bg); color: var(--ink);
    width: min(28rem, calc(100vw - 2rem)); max-height: calc(100svh - 2rem); overflow: hidden;
    box-shadow: 0 0 0 1px #000, 0 24px 60px rgba(0,0,0,.6); }
  .win[data-moved] { margin: 0; right: auto; bottom: auto; }
  .win::backdrop { background: rgba(0, 0, 0, .55); }
  .win-bar { display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .35rem .35rem .35rem .9rem;
    background: #1E1E1E; border-bottom: 1px solid #3C3C3C; user-select: none; touch-action: none; }
  @media (min-width: 48rem) and (pointer: fine) { .win-bar { cursor: grab; } .win-bar:active { cursor: grabbing; } }
  .win-title { font-size: .9375rem; font-weight: 650; color: var(--blue); font-variation-settings: 'wdth' 100; margin: 0; }
  .win-close { font: inherit; font-size: 1.4rem; line-height: 1; width: 44px; height: 36px; border-radius: 6px; cursor: pointer;
    background: transparent; color: var(--ink); border: 1px solid #3C3C3C; }
  .win-close:hover { border-color: var(--gold); color: var(--gold); }
  .win-body { padding: 1rem; display: grid; gap: .75rem; }
  .win-canvas { width: 100%; aspect-ratio: 16 / 10; display: block; }
  .win-note { margin: 0; color: var(--muted); font-size: .9375rem; }
  .affil { margin: 1rem 0 0; font-size: clamp(1rem, 1.6vw, 1.25rem); color: var(--muted); font-variation-settings: 'wdth' 92; }

  .entries { position: relative; display: grid; grid-template-columns: 1fr; border-top: 3px solid var(--ink); }
  @media (min-width: 48rem) { .entries { grid-template-columns: 1fr 1fr; } .entry + .entry { border-left: 3px solid var(--ink); padding-left: clamp(1rem, 3vw, 2.5rem); } }
  .entry { padding: 1.5rem clamp(0rem, 3vw, 2.5rem) 2rem 0; display: grid; gap: .6rem; align-content: start; }
  .entry + .entry { border-top: 1px solid var(--rule); }
  @media (min-width: 48rem) { .entry + .entry { border-top: 0; } }
  .entry-label { font-size: clamp(1.4rem, 2.6vw, 2rem); font-weight: 760; font-variation-settings: 'wdth' 118; line-height: 1.05; }
  .entry-headline { margin: 0; max-width: 46ch; }

  /* Buttons: blue outline at rest, gold on hover/focus, gold fill when pressed. */
  .pill {
    font: inherit; font-weight: 600; cursor: pointer; justify-self: start; min-height: 44px;
    padding: .55rem 1.1rem; border-radius: 999px; border: 2px solid var(--blue); background: transparent; color: var(--blue);
  }
  .pill:hover { border-color: var(--gold); color: var(--gold); box-shadow: inset 0 0 0 1px var(--gold); }
  .pill[aria-pressed='true'] { background: var(--gold); border-color: var(--gold); color: var(--on-accent); box-shadow: none; }

  /* Work */
  .work, .about, .pubs, .contact { padding: clamp(4rem, 10vw, 7rem) var(--pad) 0; }
  .sec-h { font-size: clamp(2.2rem, 6vw, 4.5rem); font-weight: 800; font-variation-settings: 'wdth' 125; line-height: .95; letter-spacing: -.015em; }
  .work-head { display: grid; gap: 1rem; margin-bottom: 1.5rem; }
  @media (min-width: 60rem) { .work-head { grid-template-columns: auto 1fr; align-items: end; column-gap: 3rem; } .filter-status { grid-column: 2; } }
  .filters { display: flex; flex-wrap: wrap; gap: .5rem; }
  .filter-status { margin: 0; color: var(--muted); font-variation-settings: 'wdth' 85; min-height: 1.6em; }
  .layers { list-style: none; margin: 0; padding: 0; background-position: 0 0, 0 5px; }
  .layer { padding-bottom: 8px; }
  .layer :global(.v3-spot) { padding: 0; border-radius: 10px; background-color: transparent; box-shadow: none; }
  .layer :global(.spotlight-card__border) { background: transparent; }
  .layer-link { display: grid; grid-template-columns: 88px 1fr; gap: .4rem 1.25rem; padding: 1.4rem .25rem 1.25rem; text-decoration: none; color: var(--ink); align-items: center; }
  @media (min-width: 60rem) { .layer-link { grid-template-columns: 132px minmax(0, 1fr) 16rem; gap: 2rem; } }
  .layer-link:hover, .layer-link:active { color: var(--ink); }
  .layer-link:hover .layer-title, .layer-link:focus-visible .layer-title { color: var(--gold); text-decoration: underline; text-decoration-thickness: 3px; }
  .layer-link :global(.layer-thumb) { width: 88px; height: 66px; border-radius: 6px; overflow: hidden; }
  @media (min-width: 60rem) { .layer-link :global(.layer-thumb) { width: 132px; height: 99px; } }
  .layer-main { display: grid; gap: .25rem; }
  .layer-title { color: var(--blue); font-size: clamp(1.15rem, 2vw, 1.5rem); font-weight: 700; line-height: 1.2; font-variation-settings: 'wdth' 108; }
  .layer-title .draft-label { margin-left: .6rem; vertical-align: .15em; }
  .layer-problem { color: var(--muted); max-width: 62ch; }
  .layer-meta { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: .25rem 1rem; font-variation-settings: 'wdth' 80; font-weight: 500; color: var(--muted); }
  @media (min-width: 60rem) { .layer-meta { grid-column: auto; display: grid; justify-items: end; text-align: right; } }
  .layer-years { color: var(--ink); font-weight: 650; }

  /* About */
  .about-grid { display: grid; gap: 2.5rem; margin-top: 2rem; }
  @media (min-width: 60rem) { .about-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 4rem; } }
  .bio :global(.bio-reveal) { margin: 0; }
  .bio :global(.bio-reveal-text) { font-size: clamp(1.2rem, 2vw, 1.5rem); line-height: 1.45; font-weight: 400; max-width: 36ch; font-variation-settings: 'wdth' 96; }
  .cv h3, .sub-h { font-size: 1.125rem; font-weight: 750; font-variation-settings: 'wdth' 112; margin: 0 0 .75rem; }
  .cv h3:not(:first-child) { margin-top: 2rem; }
  .timeline { list-style: none; margin: 0; padding: 0; display: grid; gap: .9rem; }
  .timeline li, .pub-list li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1rem; }
  @media (max-width: 30rem) { .timeline li, .pub-list li { grid-template-columns: 1fr; gap: .1rem; } }
  .t-years, .pub-year { font-variation-settings: 'wdth' 80; font-weight: 600; color: var(--muted); }
  .t-body { max-width: 66ch; }

  /* Publications */
  .pub-list { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 1.4rem; }
  .pubs .sub-h { margin-top: 3.5rem; }
  .pubs .sub-h + .pub-list { margin-top: 1rem; }
  .pub-body { display: grid; gap: .2rem; max-width: 70ch; }
  .pub-title { font-weight: 650; font-size: 1.125rem; line-height: 1.35; }
  .pub-cite { color: var(--muted); }
  .pub-type { white-space: nowrap; }

  /* Contact */
  .contact { padding-bottom: 6rem; }
  .contact-list { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; }
  .contact-list li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1rem; align-items: baseline; padding: 1rem 0; border-top: 1px solid var(--rule); }
  .c-label { color: var(--muted); font-variation-settings: 'wdth' 80; font-weight: 600; }
  .contact-list :global(.magnet-wrap) { display: inline-block; }
  .contact-list :global(a) { font-size: clamp(1.15rem, 3.2vw, 2.1rem); font-weight: 700; font-variation-settings: 'wdth' 110; overflow-wrap: anywhere; line-height: 1.2; }
  @media (max-width: 30rem) { .contact-list li { grid-template-columns: 1fr; gap: .1rem; } }

  @media (max-width: 47.99rem) {
    .stage { top: 3.5rem; left: 0; right: 0; width: 100%; height: 56.25vw; }
    .hero { padding-top: 3.5rem; grid-template-rows: auto auto; min-height: 0; }
    .hero-text { padding: calc(56.25vw + 1.25rem) 0 1.5rem; }
  }
</style>
